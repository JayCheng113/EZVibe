{
  "name": "ezvibe",
  "version": "0.2.0",
  "description": "Claude Code multi-session orchestrator — manage multiple AI coding sessions from one UI",
  "keywords": ["claude", "claude-code", "terminal", "orchestrator", "ai", "coding"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayCheng113/EZVibe.git"
  },
  "bin": {
    "ezvibe": "./bin/ezvibe.js"
  },
  "files": [
    "bin/",
    "server/",
    "src/",
    "public/",
    "next.config.js",
    "tsconfig.json",
    "tailwind.config.ts",
    "postcss.config.js",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently \"next dev\" \"tsx watch server/index.ts\"",
    "build": "next build",
    "start": "node bin/ezvibe.js",
    "postinstall": "npx next build || true"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "next": "^15.1.0",
    "node-pty": "^1.2.0-beta.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "swr": "^2.2.0",
    "uuid": "^11.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0"
  }
}
